{
  "name": "vapor-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "wp:deploy": "bash ./scripts/deploy-wordpress-assets.sh",
    "wp:setup:remote": "bash ./scripts/remote-wp-setup.sh",
    "wp:deploy:all": "bash ./scripts/deploy-and-setup.sh",
    "wp:local": "bash ./scripts/docker-local-up.sh",
    "wp:local:down": "bash ./scripts/docker-local-down.sh",
    "test": "php tests/run.php --suite=all",
    "test:unit": "php tests/run.php --suite=unit",
    "test:integration": "php tests/run.php --suite=integration",
    "test:lint": "bash ./scripts/php-lint.sh",
    "test:live": "TINY_LIVE=1 php tests/live/smoke-tiny.php",
    "e2e:subir": "bash ./scripts/e2e-up.sh",
    "e2e:derrubar": "wp-env stop",
    "e2e:preparar": "wp-env run cli wp eval-file wp-content/vh-e2e/setup.php",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@wordpress/env": "^10.39.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
