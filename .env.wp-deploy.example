#############################################
# Deploy WordPress (CloudPanel) - Vapor Hub
#############################################
#
# Preencha quando o host do piloto for informado.
# Não reutilize credenciais de outro produto.
#
# CloudPanel costuma ter DOIS usuarios:
#   FTP  -> envia tema/plugin
#   SSH  -> WP-CLI e setup remoto

# ---------- FTP (upload tema/plugin) ----------
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=

# ftp | sftp
FTP_PROTOCOL=ftp
FTP_TLS=false

# ---------- Pastas locais ----------
# Relativas à raiz do projeto
LOCAL_THEME_DIR=wp-vapor-hub/themes/vapor-hub
LOCAL_PLUGIN_DIR=wp-vapor-hub/plugins/vapor-hub-loja
LOCAL_SETUP_DIR=wp-vapor-hub/setup

# ---------- Pastas remotas ----------
# Com FTP em chroot na raiz do WordPress,
# use caminhos relativos ao site: /wp-content/themes, tmp/...
REMOTE_THEMES_DIR=/wp-content/themes
REMOTE_PLUGINS_DIR=/wp-content/plugins
REMOTE_SETUP_DIR=tmp/vapor-hub-setup

THEME_SLUG=vapor-hub
PLUGIN_SLUG=vapor-hub-loja

# Nome amigavel nos logs (opcional)
DEPLOY_SITE_NAME=piloto.example

# true = simula sem enviar
DRY_RUN=true

# true = remove remoto que nao existe local
DELETE_REMOTE=false

# true = debug verboso do lftp
LFTP_DEBUG=false

# ---------- SSH / WP-CLI (validacao remota; npm run wp:deploy:all) ----------
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Opcional (autenticacao por senha): requer sshpass instalado localmente
SSH_PASS=
# Opcional (autenticacao por chave): recomendado
SSH_KEY_PATH=~/.ssh/id_ed25519

# Caminho absoluto da instalacao WordPress no servidor
REMOTE_WP_PATH=

# Caminho para o WP-CLI remoto (geralmente "wp")
REMOTE_WP_CLI=wp

# Se true, conecta por SSH apos o FTP (ativar tema, relatorio; setup PHP condicional)
RUN_REMOTE_SETUP=true

# Se true, nao executa configuracao-woocommerce.php quando vh_loja_setup_concluido=1 no banco
SKIP_SETUP_IF_DONE=true

# Se true, sempre executa configuracao-woocommerce.php (ignora o marcador acima)
FORCE_REMOTE_SETUP=false
