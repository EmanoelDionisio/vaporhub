{
  "name": "newalliance/vapor-hub",
  "description": "Loja Vapor Hub — tema filho, plugin Minha Loja e suíte de testes.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload-dev": {
    "files": [
      "tests/framework/class-vh-test-case.php"
    ]
  },
  "scripts": {
    "test": "php tests/run.php --suite=all",
    "test:unit": "php tests/run.php --suite=unit",
    "test:integration": "php tests/run.php --suite=integration",
    "test:phpunit": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
